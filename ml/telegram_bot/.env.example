# Telegram-бот «Петровича». Скопируйте в .env и заполните. Пустая переменная — значение по умолчанию.

# Токен бота от @BotFather (обязательно). Имя бота (без @) — в FS_TELEGRAM_BOT_USERNAME стенда.
TB_BOT_TOKEN=
# Адрес стенда fleet_service; в docker compose — http://fleet_service:8000.
TB_STAND_URL=http://fleet_service:8000
# Ключ бота на стенде (обязательно): то же значение, что FS_TELEGRAM_SERVICE_TOKEN в ml/fleet_service/.env.
TB_STAND_TOKEN=
# Срок ответа стенда, с: ассистент отвечает до FS_CHAT_TIMEOUT_SECONDS (100 с) — с запасом.
TB_STAND_TIMEOUT_SECONDS=110
# Как часто забирать уведомления со стенда, с.
TB_OUTBOX_INTERVAL_SECONDS=20
# Короткие ключи кнопок (SQLite). В docker compose — /srv/data/bot.db в томе telegram_data.
TB_DATA_PATH=data/bot.db
# Сколько последних сообщений разговора передаётся ассистенту.
TB_HISTORY_MAX_MESSAGES=20
TB_LOG_LEVEL=INFO
