# Настройки стенда fleet_service (префикс FS_). Скопируйте в .env и заполните; .env не коммитится.
# Пустое значение — значение по умолчанию из src/fleet_service/config.py.

# --- OpenRouter ---
# Ключ API OpenRouter. Без ключа и модели /v1/chat отвечает 503 «ассистент не настроен».
FS_OPENROUTER_API_KEY=
# Адрес API в формате OpenAI chat completions.
FS_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Маршрутизация провайдеров: true — только провайдеры, поддерживающие все параметры запроса (tools, temperature).
FS_OPENROUTER_REQUIRE_PARAMETERS=true
# Политика сбора данных провайдером: deny — только провайдеры, не сохраняющие запросы; allow — любые.
FS_OPENROUTER_DATA_COLLECTION=deny

# --- Модель и генерация ---
# Имя модели OpenRouter с поддержкой tool calling, например openai/gpt-4o-mini. Выбирает владелец стенда.
FS_LLM_MODEL=
# Температура генерации (0..2): чем ниже, тем меньше фантазии.
FS_LLM_TEMPERATURE=0.2
# Предел длины ответа модели в токенах.
FS_LLM_MAX_TOKENS=1024
# Таймаут одного обращения к модели, с.
FS_LLM_TIMEOUT_SECONDS=60
# Сколько раз за один ответ можно обратиться к модели (каждый раунд вызова tools — ещё одно обращение).
FS_AGENT_MAX_ITERATIONS=5
# Общий срок на ответ /v1/chat, с. Приложение ждёт 120 с — держите меньше.
FS_CHAT_TIMEOUT_SECONDS=100
# Файл системного промпта; пусто — встроенный src/fleet_service/prompts/system.md.
FS_SYSTEM_PROMPT_PATH=

# --- Лимиты запроса чата ---
# Сколько последних сообщений истории передаётся модели; старые отбрасываются.
FS_CHAT_MAX_MESSAGES=40
# Максимальная длина одного сообщения, символов; длиннее — 422.
FS_CHAT_MAX_MESSAGE_CHARS=4000

# --- AutoGRAPH (проверка токена сессии пользователя) ---
FS_AUTOGRAPH_BASE_URL=https://web.tk-ekat.ru/ServiceJSON/
# Таймаут запроса к AutoGRAPH, с.
FS_AUTOGRAPH_TIMEOUT_SECONDS=15
# Сколько секунд помнить итог проверки токена (0 — проверять каждый запрос).
FS_AUTH_CACHE_TTL_SECONDS=60
# Сколько проверок держать в кэше одновременно.
FS_AUTH_CACHE_MAX_ENTRIES=1000

# --- Прочее ---
# Уровень логов: DEBUG, INFO, WARNING. Токены и ключи в логах маскируются.
FS_LOG_LEVEL=INFO
