# Настройки стенда fleet_service (префикс FS_). Скопируйте в .env и заполните; .env не коммитится.
# Пустое значение — значение по умолчанию из src/fleet_service/config.py.

# --- OpenRouter ---
# Ключ API OpenRouter. Без ключа и модели /v1/chat отвечает 503 «ассистент не настроен».
FS_OPENROUTER_API_KEY=
# Адрес API в формате OpenAI chat completions.
FS_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Маршрутизация провайдеров: true — только провайдеры, поддерживающие все параметры запроса (tools, temperature).
FS_OPENROUTER_REQUIRE_PARAMETERS=true
# Политика сбора данных провайдером: deny — только провайдеры, не сохраняющие запросы; allow — любые.
FS_OPENROUTER_DATA_COLLECTION=deny
# Порядок провайдеров одной модели: latency | throughput | price; пусто — порядок OpenRouter по умолчанию.
FS_OPENROUTER_PROVIDER_SORT=
# Переходить к другому провайдеру той же модели при сбое (true — больше шансов получить ответ).
FS_OPENROUTER_ALLOW_FALLBACKS=true

# --- Прокси модели (LiteLLM, сервис llm_proxy) ---
# Адрес прокси. В docker compose задаётся не здесь, а в docker-compose.yml (http://llm_proxy:4000); обойти прокси
# в compose — строка `FS_LLM_PROXY_URL=` в ml/.env. Пусто — стенд обращается к OpenRouter напрямую, без повторов
# (запуск без compose). Конфигурацию прокси строит
# python -m fleet_service.llm_proxy из настроек этого файла при каждом docker compose up.
FS_LLM_PROXY_URL=
# Запасные модели OpenRouter через запятую, по порядку: берутся, если основная не ответила. Через прокси — после
# исчерпания повторов основной (по id копии видно, какая модель ответила); без прокси — полем models запроса.
# Только модели, которые не хуже основной вызывают tools, — проверка: python -m fleet_service.agent.eval_tools
# (см. README). Пусто — только основная модель.
FS_LLM_FALLBACK_MODELS=
# Повторы обращения к модели через прокси (без первой попытки) при 408, 429, 5xx и сетевой ошибке; 400, 401, 402,
# 403 не повторяются. Пауза перед n-м повтором: база · 2^(n-1), не больше максимума, плюс случайные до 0,75 с;
# Retry-After провайдера (до 60 с) — как есть. Срок ответа чата (FS_CHAT_TIMEOUT_SECONDS) повторы не продлевают.
FS_LLM_RETRIES=2
FS_LLM_RETRY_BASE_SECONDS=1
FS_LLM_RETRY_MAX_SECONDS=10
# Резервная модель вне OpenRouter — любой OpenAI-совместимый адрес (свой vLLM, LiteLLM, другой провайдер), с
# поддержкой tool calling. Прокси переходит к ней, когда не ответили основная и запасные модели: OpenRouter
# недоступен, кончились кредиты (402); пока открыт breaker модели — стенд идёт к ней сразу. Если OpenRouter не
# отвечает, а «висит», до резерва в цепочке — (FS_LLM_RETRIES + 1) × FS_LLM_TIMEOUT_SECONDS на каждую модель: это
# дольше FS_CHAT_TIMEOUT_SECONDS, такие ответы — 504, пока breaker не откроется (FS_BREAKER_FAILURES таймаутов);
# с резервом держите FS_LLM_TIMEOUT_SECONDS меньше (например, 30). Пустой адрес или модель — резерва нет. Только через
# прокси. Свою модель на стенде — профиль reserve-llm в ml/docker-compose.yml (нужен GPU, DEPLOY.md), тогда
# FS_LLM_RESERVE_BASE_URL=http://reserve_llm:8000/v1 и FS_LLM_RESERVE_MODEL — как RESERVE_LLM_MODEL в ml/.env.
# Резерв допускается после той же проверки на tools (python -m fleet_service.agent.eval_tools).
FS_LLM_RESERVE_BASE_URL=
FS_LLM_RESERVE_MODEL=
# Ключ резервного адреса; пусто — без ключа (свой vLLM).
FS_LLM_RESERVE_API_KEY=
# Резерв хуже основной по проверке на tools — к ответу через него добавляется пометка «упрощённый режим» (цифры
# не меняются: их считают tools). false — без пометки.
FS_LLM_RESERVE_DEGRADED=true

# --- Circuit breaker ---
# На AutoGRAPH, predictive_antifraud и модель: после стольких сбоев (сеть, таймаут, 5xx, 408, 429; не 4xx на неверный
# запрос) за окно, с, система считается недоступной на столько секунд — запросы сразу получают отказ, без ожидания
# таймаута; потом один пробный запрос. Для модели сбой — и ответ через резерв (основная и запасные не ответили):
# пока breaker открыт, стенд обращается сразу к резерву (если он задан), без запросов к OpenRouter.
FS_BREAKER_FAILURES=5
FS_BREAKER_WINDOW_SECONDS=30
FS_BREAKER_OPEN_SECONDS=60
# Ключ администратора для GET /v1/status (состояние breaker'ов, очередей и кэшей), заголовок
# Authorization: Bearer <ключ>. Пусто — эндпоинт выключен (404). Создать: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
FS_ADMIN_TOKEN=

# --- Модель и генерация ---
# Имя модели OpenRouter с поддержкой tool calling, например openai/gpt-4o-mini. Выбирает владелец стенда.
FS_LLM_MODEL=
# Температура генерации (0..2): чем ниже, тем меньше фантазии.
FS_LLM_TEMPERATURE=0.2
# Предел длины ответа модели в токенах.
FS_LLM_MAX_TOKENS=1024
# Таймаут одного обращения к модели, с.
FS_LLM_TIMEOUT_SECONDS=60
# Сколько раз за один ответ можно обратиться к модели (каждый раунд вызова tools — ещё одно обращение).
FS_AGENT_MAX_ITERATIONS=5
# Общий срок на ответ /v1/chat, с. Приложение ждёт 120 с — держите меньше.
FS_CHAT_TIMEOUT_SECONDS=100
# Файл системного промпта; пусто — встроенный src/fleet_service/prompts/system.md.
FS_SYSTEM_PROMPT_PATH=

# --- Лимиты запроса чата ---
# Сколько последних сообщений истории передаётся модели; старые отбрасываются.
FS_CHAT_MAX_MESSAGES=40
# Максимальная длина одного сообщения, символов; длиннее — 422.
FS_CHAT_MAX_MESSAGE_CHARS=4000

# --- Нагрузка: чат и внешние системы ---
# Значения стартовые: потолок даёт нагрузочный тест (throughput перестаёт расти, p95 резко растёт) — ставьте чуть ниже.
# Rate limit на пользователя (сессия AutoGRAPH + схема; логин из X-User-Name стенд не проверяет, поэтому не по нему):
# столько вопросов подряд, дальше — столько в минуту; сверх — 429 с Retry-After.
FS_CHAT_RATE_PER_MINUTE=10
FS_CHAT_BURST=3
# Одновременных ответов чата на процесс и ожидающих в очереди; очередь полна — сразу 503 «высокая нагрузка».
# Ожидание места входит в FS_CHAT_TIMEOUT_SECONDS.
FS_CHAT_CONCURRENCY=8
FS_CHAT_QUEUE_MAX=16
# Одновременных запросов к AutoGRAPH и к predictive_antifraud на процесс — для всех путей вместе (чат, проверки,
# scan, фоновая проверка). Фоновая проверка занимает не больше половины мест и пропускает запросы пользователей вперёд
# (при значении 1 ей достаётся единственное место). Проверка сессии ждёт место не дольше FS_AUTOGRAPH_TIMEOUT_SECONDS.
# FS_PREDICTIVE_CONCURRENCY — не больше PA_MAX_CONCURRENCY аналитики (2): тогда запросы ждут здесь, где пользователи
# идут вперёд фоновой проверки, а не в простой очереди аналитики. Одна проверка машины — два запроса (предиктив и
# антифрод). Остаток срока стенд передаёт аналитике (X-Client-Timeout): дольше она запрос в очереди не держит.
FS_AUTOGRAPH_CONCURRENCY=8
FS_PREDICTIVE_CONCURRENCY=2

# --- AutoGRAPH (проверка токена сессии пользователя; тот же адрес — для телеметрии) ---
FS_AUTOGRAPH_BASE_URL=https://web.tk-ekat.ru/ServiceJSON/
# Таймаут запроса к AutoGRAPH, с.
FS_AUTOGRAPH_TIMEOUT_SECONDS=15
# Сколько секунд помнить итог проверки токена (0 — проверять каждый запрос).
FS_AUTH_CACHE_TTL_SECONDS=60
# Сколько проверок держать в кэше одновременно.
FS_AUTH_CACHE_MAX_ENTRIES=1000

# --- AutoGRAPH: загрузка телеметрии ---
# Всего попыток запроса при сетевой ошибке (как в приложении — 3).
FS_AUTOGRAPH_RETRIES=3
# Пауза перед n-й повторной попыткой: база · 2^(n-1), не больше максимума, умноженная на случайное 0,5…1 (jitter:
# при массовом сбое повторы разных запросов не приходят в AutoGRAPH одновременно), с.
FS_AUTOGRAPH_RETRY_DELAY_SECONDS=1
FS_AUTOGRAPH_RETRY_MAX_SECONDS=10
# Таймаут ответа GetTripTables, с (ответ большой и медленный).
FS_AUTOGRAPH_TRIP_TABLES_TIMEOUT_SECONDS=60
# Длина одной части периода в GetTripTables, ч (сутки по машине — ~6 МБ JSON).
FS_AUTOGRAPH_CHUNK_HOURS=6
# Предел длины адреса запроса, символов; длиннее — параметры запрашиваются пачками.
FS_AUTOGRAPH_MAX_QUERY_CHARS=1900
# Защита от сбойного ответа: больше точек в одном треке — ответ отвергается.
FS_TRIP_TABLES_MAX_POINTS=500000

# --- Телеметрия: кэши и пределы ---
# Сколько секунд помнить список машин пользователя (EnumDevices) по его токену и схеме.
FS_DEVICES_CACHE_TTL_SECONDS=300
# Сколько секунд помнить набор параметров прибора (EnumParameters).
FS_PARAMETERS_CACHE_TTL_SECONDS=3600
# Сколько наборов параметров (машин) держать в кэше одновременно.
FS_PARAMETERS_CACHE_MAX_ENTRIES=5000
# Сколько секунд помнить готовую телеметрию (ключ: схема, машина, период, пояс; общая для пользователей схемы).
FS_TELEMETRY_CACHE_TTL_SECONDS=120
# Сколько наборов телеметрии держать в кэше одновременно.
FS_TELEMETRY_CACHE_MAX_ENTRIES=200
# Самый длинный период одного запроса телеметрии, ч (в приложении — 7 дней).
FS_TELEMETRY_MAX_PERIOD_HOURS=168

# --- Tools ассистента ---
# Сколько машин возвращает list_vehicles за один вызов (остальные — через фильтр query).
FS_TOOL_MAX_VEHICLES=50
# Сколько аномалий возвращает check_vehicle (общее число — в поле total).
FS_TOOL_MAX_ANOMALIES=20
# Предел размера ответа одного tool в символах JSON; больше — модель получает ошибку вместо данных.
FS_TOOL_MAX_RESULT_CHARS=16000

# --- Аналитика predictive_antifraud ---
# Адрес сервиса; в docker compose — имя сервиса. Пусто — аналитика не вызывается (проверка только по правилам).
FS_PREDICTIVE_URL=http://predictive_antifraud:8000
# Ключ X-API-Key: то же значение, что PA_API_KEY в ml/predictive_antifraud/.env; пусто — заголовок не передаётся.
FS_PREDICTIVE_API_KEY=
# Таймаут запроса к аналитике, с. Недоступность аналитики не ломает проверку по правилам. Держите больше
# PA_REQUEST_DEADLINE_SECONDS сервиса аналитики: иначе он считает запросы, которые стенд уже не ждёт.
FS_PREDICTIVE_TIMEOUT_SECONDS=30

# --- Пороги правил аномалий (как в приложении, BaselineAnomalyDetector) ---
# Резкое падение уровня топлива: не меньше ... л за ... мин; после срабатывания ... мин новых не создаём.
FS_RULES__FUEL_DROP_MIN_LITERS=25
FS_RULES__FUEL_DROP_WINDOW_MINUTES=15
FS_RULES__FUEL_DROP_COOLDOWN_MINUTES=60
# Пропадание питания: с этой длительности, мин, — WARNING, короче — INFO.
FS_RULES__POWER_LONG_MINUTES=2
# Напряжение ниже этого, В, — «нет данных» (CAN при выключенном зажигании шлёт 0).
FS_RULES__VOLTAGE_MIN_VALUE=5
# Медиана напряжения выше этого, В, — бортсеть 24 В, иначе 12 В.
FS_RULES__VOLTAGE_24V_MEDIAN=18
# Бортсеть 24 В: ниже low — WARNING, ниже critical — CRITICAL, выше high — перезаряд.
FS_RULES__VOLTAGE_24V_LOW=24
FS_RULES__VOLTAGE_24V_CRITICAL=22
FS_RULES__VOLTAGE_24V_HIGH=30.5
# Бортсеть 12 В: те же границы.
FS_RULES__VOLTAGE_12V_LOW=12
FS_RULES__VOLTAGE_12V_CRITICAL=11
FS_RULES__VOLTAGE_12V_HIGH=15
# Перезаряд выше high на столько вольт — CRITICAL.
FS_RULES__VOLTAGE_CRITICAL_OVER_HIGH=1.5
# Напряжение проверяется на оборотах выше ... и эпизодах не короче ... мин.
FS_RULES__VOLTAGE_MIN_RPM=500
FS_RULES__VOLTAGE_MIN_MINUTES=5
# Перегрев: выше ... °C — WARNING, выше critical — CRITICAL; эпизод не короче ... мин.
FS_RULES__OVERHEAT_CELSIUS=100
FS_RULES__OVERHEAT_CRITICAL_CELSIUS=105
FS_RULES__OVERHEAT_MIN_MINUTES=2
# Давление масла ниже ... кПа (0 — нет данных) на оборотах выше ..., не короче ... мин.
FS_RULES__OIL_LOW_KPA=100
FS_RULES__OIL_MIN_RPM=800
FS_RULES__OIL_MIN_MINUTES=1
# Тормозные контуры ниже ... кПа на оборотах выше ..., не короче ... мин.
FS_RULES__BRAKE_LOW_KPA=550
FS_RULES__BRAKE_MIN_RPM=600
FS_RULES__BRAKE_MIN_MINUTES=10

# --- Хранилище аномалий и решений ---
# Адрес базы SQLAlchemy. Пусто — SQLite-файл ./data/fleet.db от рабочего каталога; в образе — /srv/data/fleet.db,
# это том fleet_data в docker compose (данные переживают перезапуск и пересборку). Задавая свой адрес для compose,
# держите файл внутри /srv/data, иначе база пропадёт при пересоздании контейнера.
FS_DB_URL=
# Применять миграции схемы базы при старте (false — вручную: python -m fleet_service.store.migrate).
FS_DB_AUTO_MIGRATE=true
# Шаг канонической сетки проверок с сохранением, мин (сетка от начала эпохи UTC). Изменение меняет id новых аномалий.
FS_SCAN_BUCKET_MINUTES=1
# Сколько машин проверяется параллельно в одном запросе /v1/anomalies/scan (как в приложении — 2).
FS_SCAN_CONCURRENCY=2
# Сколько дней хранить аномалии и решения (по времени события).
FS_STORE_RETENTION_DAYS=180
# Больше записей за один запрос GET /v1/anomalies не отдаётся.
FS_ANOMALIES_MAX_LIMIT=500
# Перенос решений с устройства: допуск по времени события при сопоставлении, мин.
FS_IMPORT_TIME_TOLERANCE_MINUTES=10
# Перенос решений: запас окна проверки до и после времени перенесённых аномалий, мин.
FS_IMPORT_SCAN_MARGIN_MINUTES=60
# Перенос решений: сколько записей принимается за один запрос (в приложении хранится до 500).
FS_IMPORT_MAX_ITEMS=1000

# --- Фоновая проверка на стенде ---
# Стенд сам проверяет с сохранением каждую схему, где приложение выдало доступ («Фоновая проверка на стенде»),
# без телефона. Доступ — токен сессии AutoGRAPH от приложения, пока он жив; пароль — только если пользователь
# разрешил стенду входить самостоятельно. Токен и пароль хранятся в базе зашифрованными этим ключом.
# Ключ шифрования доступа: 32 байта в base64. Пусто — фоновая проверка выключена, доступ не принимается. Создать:
#   python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Держите ключ только здесь (не в томе с базой): резервная копия базы без ключа не раскрывает ни токены, ни пароли.
# Смена ключа делает сохранённый доступ нерасшифровываемым — приложения выдадут его заново при следующем обновлении,
# сохранённые пароли придётся разрешить заново.
FS_ACCESS_ENCRYPTION_KEY=
# Выключатель фоновой проверки (false — расписание не запускается, доступ не принимается; ключ можно оставить).
FS_BACKGROUND_ENABLED=true
# Как часто проверять, мин (дробное — для отладки), и за сколько последних часов (не больше FS_TELEMETRY_MAX_PERIOD_HOURS).
FS_BACKGROUND_INTERVAL_MINUTES=15
FS_BACKGROUND_WINDOW_HOURS=3
# Сколько машин проверяется одновременно по всем схемам (запросы к AutoGRAPH; в приложении — 2).
FS_BACKGROUND_CONCURRENCY=2
# Доступ, который приложение не подтверждало столько дней (удалили приложение, потеряли телефон), удаляется.
FS_BACKGROUND_ACCESS_TTL_DAYS=30
# Больше id аномалий за один запрос /v1/notifications/claim (одно уведомление на пользователя) не принимается.
FS_NOTIFICATION_CLAIM_MAX_IDS=500

# --- Письма ---
# Ассистент готовит черновик (tool draft_email), пользователь подтверждает в приложении, стенд отправляет по SMTP.
# Пустые FS_SMTP_HOST, FS_SMTP_FROM или FS_EMAIL_RECIPIENTS_PATH — письма выключены, tools писем модели не предлагаются.
FS_SMTP_HOST=
FS_SMTP_PORT=587
# starttls — STARTTLS (обычно порт 587), ssl — TLS сразу (465), none — без шифрования (только локальный сервер).
FS_SMTP_SECURITY=starttls
# Логин и пароль SMTP; пустой логин — без авторизации.
FS_SMTP_USERNAME=
FS_SMTP_PASSWORD=
# Адрес отправителя (From).
FS_SMTP_FROM=
FS_SMTP_TIMEOUT_SECONDS=30
# Файл получателей (TOML, образец — recipients.example.toml): id, имя, роль, адрес, схемы. Читается при старте —
# после правки перезапустите стенд. В docker compose каталог ml/fleet_service/config смонтирован в /srv/config:
# FS_EMAIL_RECIPIENTS_PATH=/srv/config/recipients.toml
FS_EMAIL_RECIPIENTS_PATH=
# Сколько минут живёт черновик: позже подтвердить нельзя.
FS_EMAIL_DRAFT_TTL_MINUTES=30
# Не больше стольких отправленных писем на пользователя за период, ч. Логин (X-User-Name) стенд не проверяет,
# поэтому есть и общий предел на схему за тот же период.
FS_EMAIL_LIMIT_PER_USER=20
FS_EMAIL_LIMIT_PER_SCHEMA=100
FS_EMAIL_LIMIT_PERIOD_HOURS=24
# Пределы черновика: получателей, символов темы и текста, черновиков за один ответ ассистента.
FS_EMAIL_MAX_RECIPIENTS=10
FS_EMAIL_MAX_SUBJECT_CHARS=200
FS_EMAIL_MAX_BODY_CHARS=5000
FS_EMAIL_MAX_DRAFTS_PER_REPLY=3

# --- Прочее ---
# Уровень логов: DEBUG, INFO, WARNING. Токены и ключи в логах маскируются.
FS_LOG_LEVEL=INFO
