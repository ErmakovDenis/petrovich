# Настройки сервиса (префикс PA_). Скопируйте в .env и поправьте при необходимости.
PA_MODELS_DIR=models
PA_PREDICTIVE_THRESHOLD=0.8
PA_ANTIFRAUD_THRESHOLD=0.8
PA_CRITICAL_THRESHOLD=0.95
# Ключ для заголовка X-API-Key; пусто — проверка отключена (только для локальной разработки).
PA_API_KEY=
# Предел нагрузки на /v1/*: одновременно в расчёте не больше PA_MAX_CONCURRENCY запросов, в очереди — не больше
# PA_QUEUE_MAX; очередь полна — сразу 503 с Retry-After (стенд показывает аналитику как unavailable, правила работают).
# Значение PA_MAX_CONCURRENCY и как оно получено — README, раздел «Нагрузка»; с появлением модели тест повторить.
PA_MAX_CONCURRENCY=2
PA_QUEUE_MAX=16
# Запрос, простоявший в очереди дольше, с, не считается (503): стенд его уже не ждёт. Держите меньше
# FS_PREDICTIVE_TIMEOUT_SECONDS в ml/fleet_service/.env (по умолчанию 30); кроме того, стенд присылает остаток своего
# срока (X-Client-Timeout) — дольше него запрос тоже не ждёт. FS_PREDICTIVE_CONCURRENCY стенда — не больше этого предела.
PA_REQUEST_DEADLINE_SECONDS=25
